{{define "layout"}}<!DOCTYPE html>
<html lang="{{.LangTag}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.T "title"}}</title>
<meta name="description" content="{{.T "description"}}">

<!--
  SEO + social. The page URL is rebuilt from URLBase (flag-controlled,
  defaults to the production origin) + Path + ?lang=<current>. This
  keeps the canonical correct behind any reverse proxy without touching
  the template per-environment.
-->
<link rel="canonical" href="{{.URLBase}}{{.Path}}?lang={{.Lang}}">
<link rel="alternate" hreflang="en" href="{{.URLBase}}{{.Path}}?lang=en">
<link rel="alternate" hreflang="th" href="{{.URLBase}}{{.Path}}?lang=th">
<link rel="alternate" hreflang="x-default" href="{{.URLBase}}{{.Path}}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="agentmem">
<meta property="og:title" content="{{.T "title"}}">
<meta property="og:description" content="{{.T "description"}}">
<meta property="og:url" content="{{.URLBase}}{{.Path}}?lang={{.Lang}}">
<meta property="og:image" content="{{.URLBase}}/assets/opengraph-agentmem.png">
<meta property="og:locale" content="{{.LangTag}}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{.T "title"}}">
<meta name="twitter:description" content="{{.T "description"}}">
<meta name="twitter:image" content="{{.URLBase}}/assets/opengraph-agentmem.png">

<!-- Mobile browser chrome (Safari address bar, Android task switcher). -->
<meta name="theme-color" content="#9ee22e" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)">
<script>
(function () {
  /* Bare paths are always EN at the edge. Send TH users to ?lang=th
   * before paint so cookie / Accept-Language still win without
   * making / uncacheable. */
  try {
    if (!/[?&]lang=/.test(location.search)) {
      var lang = "";
      var m = document.cookie.match(/(?:^|; )lang=([^;]*)/);
      if (m) lang = decodeURIComponent(m[1]);
      if (lang !== "th" && lang !== "en") {
        var nav = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        if (String(nav).toLowerCase().indexOf("th") === 0) lang = "th";
      }
      if (lang === "th") {
        var u = new URL(location.href);
        u.searchParams.set("lang", "th");
        location.replace(u.pathname + u.search + u.hash);
      }
    }
  } catch (e) {}

  /* Only lock theme when the user has toggled; otherwise follow system. */
  try {
    var t = localStorage.getItem("agentmem-theme");
    if (t === "light" || t === "dark") {
      document.documentElement.setAttribute("data-theme", t);
    }
  } catch (e) {}

  /* Pick the matching mascots for the resolved theme so the brand and
   * lede icons don't flash before the deferred JS in /js/index.js runs.
   * NOTE: the file suffix is named for the mascot's fill — "-light"
   * is a LIGHT-colored robot (visible on a dark bg), "-dark" is a
   * DARK-colored robot (visible on a light bg). So we INVERT the
   * theme → mascot mapping. */
  try {
    var prefersDark =
      window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: dark)").matches;
    var resolved = document.documentElement.getAttribute("data-theme") ||
      (prefersDark ? "dark" : "light");
    /* Inverted: dark theme uses the -light mascot, light theme uses
     * the -dark mascot, so each is always visible against its bg. */
    var mascotName = resolved === "dark" ? "light" : "dark";
    var brandMascot = document.getElementById("brand-mascot");
    if (brandMascot) {
      brandMascot.src =
        "/assets/icons/agentmem-mascot-normal-" + mascotName + ".png";
    }
    var ledeMascot = document.getElementById("lede-mascot");
    if (ledeMascot) {
      ledeMascot.src =
        "/assets/icons/agentmem-mascot-heart-" + mascotName + ".png";
    }
  } catch (e) {}
})();
</script>
<link rel="icon" type="image/png" href="/assets/favicon/favicon-96x96.png" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg">
<link rel="shortcut icon" href="/assets/favicon/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="Agentmem">
<link rel="manifest" href="/assets/favicon/site.webmanifest">
<link rel="stylesheet" href="/assets/vendor/fonts/caveat.css">
<link rel="stylesheet" href="/assets/vendor/fonts/playpen-sans-thai.css">
<link rel="stylesheet" href="/assets/vendor/fonts/space-mono.css">
<link rel="stylesheet" href="/css/site.css">
<script src="/assets/vendor/js/htmx.min.js"></script>
<script src="/assets/vendor/js/htmx-ext-preload.js"></script>
<meta name="htmx-config" content='{"defaultSwapDelay":0,"defaultSettleDelay":0,"historyCacheSize":20}'>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5862T3G8');</script>
<!-- End Google Tag Manager -->

<!--
  Structured data: schema.org SoftwareApplication. Kept single-line so
  the Go template can safely interpolate page-localised strings
  (description is i18n-controlled and trusted) without breaking JSON.
-->
<script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"agentmem","description":"{{.T "description"}}","url":"{{.URLBase}}{{.Path}}?lang={{.Lang}}","applicationCategory":"DeveloperApplication","operatingSystem":"macOS, Linux, Windows","image":"{{.URLBase}}/assets/opengraph-agentmem.png","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"author":{"@type":"Organization","name":"THAMTECH Co., Ltd.","url":"https://www.thamtech.co/"}}</script>
</head>
<body hx-boost="true" hx-ext="preload" hx-target="#content" hx-select="#content" hx-swap="innerHTML show:none settle:0 swap:0">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5862T3G8"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<div class="chrome-toggles" role="group" aria-label="{{.T "common.chrome.aria"}}">
  <button
    type="button"
    class="chrome-btn lang-toggle"
    id="lang-toggle"
    data-lang="{{.Lang}}"
    data-label-en="{{.T "common.lang.to_en"}}"
    data-label-th="{{.T "common.lang.to_th"}}"
    data-code-en="{{.T "common.lang.code_en"}}"
    data-code-th="{{.T "common.lang.code_th"}}"
    {{if eq .Lang "th"}}
    aria-label="{{.T "common.lang.to_en"}}"
    title="{{.T "common.lang.to_en"}}"
    {{else}}
    aria-label="{{.T "common.lang.to_th"}}"
    title="{{.T "common.lang.to_th"}}"
    {{end}}
  >{{if eq .Lang "th"}}{{.T "common.lang.code_en"}}{{else}}{{.T "common.lang.code_th"}}{{end}}</button>
  <button
    type="button"
    class="chrome-btn theme-toggle"
    id="theme-toggle"
    data-label-light="{{.T "common.theme.to_light"}}"
    data-label-dark="{{.T "common.theme.to_dark"}}"
    aria-label="{{.T "common.theme.to_dark"}}"
  ></button>
</div>
<div id="main">

  {{template "header" .}}

  <div id="content" preload="mouseover">

    {{template "nav" .}}

    <div class="wrap">

      {{if .Home}}
      <p class="lede">
      {{.T "tagline"}}
      <img id="lede-mascot" class="lede-mascot" src="/assets/icons/agentmem-mascot-heart-dark.png" alt="" width="50">
      </p>
      {{else}}
      <p class="crumb"><a href="{{.L "/"}}">{{.T "common.crumb.home"}}</a> · {{.T "common.crumb.docs"}} / {{.T "heading"}}</p>
      {{end}}

      {{if eq .Content "index"}}{{template "index" .}}
      {{else if eq .Content "install"}}{{template "install" .}}
      {{else if eq .Content "commands"}}{{template "commands" .}}
      {{else if eq .Content "integrations"}}{{template "integrations" .}}
      {{else if eq .Content "how-it-works"}}{{template "how-it-works" .}}
      {{end}}

    </div>

  </div>

  {{template "footer" .}}

</div>
<script src="/js/index.js"></script>
</body>
</html>
{{end}}
