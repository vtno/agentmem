{{define "layout"}}<!DOCTYPE html>
<html lang="{{.LangTag}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.T "title"}}</title>
<meta name="description" content="{{.T "description"}}">
<script>
(function () {
  /* Only lock theme when the user has toggled; otherwise follow system. */
  try {
    var t = localStorage.getItem("agentmem-theme");
    if (t === "light" || t === "dark") {
      document.documentElement.setAttribute("data-theme", t);
    }
  } catch (e) {}

  /* Pick the matching mascot for the resolved theme so the brand icon
   * doesn't flash before the deferred JS in /js/index.js runs.
   * NOTE: the file suffix is named for the mascot's fill — "-light"
   * is a LIGHT-colored robot (visible on a dark bg), "-dark" is a
   * DARK-colored robot (visible on a light bg). So we INVERT the
   * theme → mascot mapping. */
  try {
    var mascot = document.getElementById("brand-mascot");
    if (mascot) {
      var prefersDark =
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches;
      var resolved = document.documentElement.getAttribute("data-theme") ||
        (prefersDark ? "dark" : "light");
      /* Inverted: dark theme uses the -light mascot, light theme uses
       * the -dark mascot, so each is always visible against its bg. */
      var mascotName = resolved === "dark" ? "light" : "dark";
      mascot.src = "/assets/icons/agentmem-mascot-normal-" + mascotName + ".png";
    }
  } catch (e) {}
})();
</script>
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/site.css">
<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/htmx-ext-preload@2.1.2" integrity="sha384-PRIcY6hH1Y5784C76/Y8SqLyTanY9rnI3B8F3+hKZFNED55hsEqMJyqWhp95lgfk" crossorigin="anonymous"></script>
<meta name="htmx-config" content='{"defaultSwapDelay":0,"defaultSettleDelay":0,"historyCacheSize":20}'>
</head>
<body hx-boost="true" hx-ext="preload" hx-target="#main" hx-select="#main" hx-swap="innerHTML show:window:top settle:0 swap:0">
<div class="chrome-toggles" role="group" aria-label="{{.T "common.chrome.aria"}}">
  <button
    type="button"
    class="chrome-btn lang-toggle"
    id="lang-toggle"
    data-lang="{{.Lang}}"
    data-label-en="{{.T "common.lang.to_en"}}"
    data-label-th="{{.T "common.lang.to_th"}}"
    data-code-en="{{.T "common.lang.code_en"}}"
    data-code-th="{{.T "common.lang.code_th"}}"
    {{if eq .Lang "th"}}
    aria-label="{{.T "common.lang.to_en"}}"
    title="{{.T "common.lang.to_en"}}"
    {{else}}
    aria-label="{{.T "common.lang.to_th"}}"
    title="{{.T "common.lang.to_th"}}"
    {{end}}
  >{{if eq .Lang "th"}}{{.T "common.lang.code_en"}}{{else}}{{.T "common.lang.code_th"}}{{end}}</button>
  <button
    type="button"
    class="chrome-btn theme-toggle"
    id="theme-toggle"
    data-label-light="{{.T "common.theme.to_light"}}"
    data-label-dark="{{.T "common.theme.to_dark"}}"
    aria-label="{{.T "common.theme.to_dark"}}"
  ></button>
</div>
<div id="main" preload="mouseover">

  {{template "header" .}}

  {{template "nav" .}}

  <div class="wrap">

    {{if .Home}}
    <p class="lede">{{.T "tagline"}}</p>
    {{else}}
    <p class="crumb"><a href="/">{{.T "common.crumb.home"}}</a> · {{.T "common.crumb.docs"}} / {{.T "heading"}}</p>
    {{end}}

    {{if eq .Content "index"}}{{template "index" .}}
    {{else if eq .Content "install"}}{{template "install" .}}
    {{else if eq .Content "commands"}}{{template "commands" .}}
    {{else if eq .Content "integrations"}}{{template "integrations" .}}
    {{else if eq .Content "how-it-works"}}{{template "how-it-works" .}}
    {{end}}

  </div>
  {{template "footer" .}}

</div>
<script src="/js/index.js"></script>
</body>
</html>
{{end}}
