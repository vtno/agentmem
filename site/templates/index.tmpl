{{define "index"}}
  <section class="section">
    <p>{{.T "hook_p1"}}</p>
    <p>{{.T "hook_p2"}}</p>
    <pre><code>{{.T "install_cmd"}}</code></pre>
    <a class="cta" href="{{.L "/docs/install"}}">{{.T "cta_install"}}</a>
    <div class="cta-row">
      <a href="https://github.com/vtno/agentmem/releases" target="_blank" rel="noopener noreferrer">{{.T "cta_releases"}}</a>
      <a href="https://github.com/vtno/agentmem/issues" target="_blank" rel="noopener noreferrer">{{.T "cta_issues"}}</a>
    </div>
  </section>

  <section class="section">
    <div class="section__label">{{.T "why.label"}}</div>
    <ul class="list">
      <li><strong>{{.T "why.yours_title"}}</strong> — {{.T "why.yours_body"}}</li>
      <li><strong>{{.T "why.pluggable_title"}}</strong> — {{.T "why.pluggable_body"}}</li>
      <li><strong>{{.T "why.portable_title"}}</strong> — {{.T "why.portable_body"}}</li>
      <li><strong>{{.T "why.vectorless_title"}}</strong> — {{.T "why.vectorless_body"}}</li>
    </ul>
  </section>

  <section class="section">
    <div class="section__label">{{.T "quick_start.label"}}</div>
    <ol class="steps">
      <li>{{.T "quick_start.step1"}}</li>
      <li>{{.T "quick_start.step2"}}</li>
      <li>{{.T "quick_start.step3"}}</li>
    </ol>
  </section>

  <section class="section">
    <div class="section__label">{{.T "harnesses.label"}}</div>
    <a class="cell" href="{{.L "/docs/integrations#claude-code"}}">
      <div class="cell__title">{{.T "harnesses.claude_title"}}</div>
      <div class="cell__desc">{{.T "harnesses.claude_desc"}}</div>
    </a>
    <a class="cell" href="{{.L "/docs/integrations#opencode"}}">
      <div class="cell__title">{{.T "harnesses.opencode_title"}}</div>
      <div class="cell__desc">{{.T "harnesses.opencode_desc"}}</div>
    </a>
    <a class="cell" href="{{.L "/docs/integrations#other"}}">
      <div class="cell__title">{{.T "harnesses.other_title"}}</div>
      <div class="cell__desc">{{.T "harnesses.other_desc"}}</div>
    </a>
  </section>

  <section class="section">
    <div class="section__label">{{.T "docs.label"}}</div>
    <a class="cell" href="{{.L "/docs/install"}}">
      <div class="cell__title">{{.T "docs.install_title"}}</div>
      <div class="cell__desc">{{.T "docs.install_desc"}}</div>
    </a>
    <a class="cell" href="{{.L "/docs/commands"}}">
      <div class="cell__title">{{.T "docs.commands_title"}}</div>
      <div class="cell__desc">{{.T "docs.commands_desc"}}</div>
    </a>
    <a class="cell" href="{{.L "/docs/integrations"}}">
      <div class="cell__title">{{.T "docs.integrations_title"}}</div>
      <div class="cell__desc">{{.T "docs.integrations_desc"}}</div>
    </a>
    <a class="cell" href="{{.L "/docs/how-it-works"}}">
      <div class="cell__title">{{.T "docs.how_title"}}</div>
      <div class="cell__desc">{{.T "docs.how_desc"}}</div>
    </a>
  </section>
{{end}}
